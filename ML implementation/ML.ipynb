      "source": [
        "def plot_pca_clusters(df, sil_score, ari_score):\n",
        "    import plotly.express as px\n",
        "\n",
        "    fig = px.scatter(\n",
        "        df,\n",
        "        x='PC1',\n",
        "        y='PC2',\n",
        "        color='cluster',\n",
        "        hover_data=['species', 'island', 'sex'],\n",
        "        title=f\"PCA Clustering | Silhouette: {sil_score:.2f} | ARI: {ari_score:.2f}\"\n",
        "    )\n",
        "\n",
        "    return fig\n",
        "plot_pca_clusters(df, sil_score, ari)"
      ],
