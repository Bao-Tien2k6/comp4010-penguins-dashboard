      "source": [
        "def plot_pca_species(df):\n",
        "    import plotly.express as px\n",
        "\n",
        "    fig = px.scatter(\n",
        "        df,\n",
        "        x='PC1',\n",
        "        y='PC2',\n",
        "        color='species',\n",
        "        title=\"Ground Truth (Species)\"\n",
        "    )\n",
        "\n",
        "    return fig\n",
        "plot_pca_species(df)"
      ],
